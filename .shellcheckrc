# .shellcheckrc - bash-markdown-link-validator
# https://github.com/fidpa/bash-markdown-link-validator
#
# Applies to src/, examples/ and install.sh. Note that the CI workflow
# (.github/workflows/lint.yml) passes --severity=error on the command line,
# which overrides the severity setting below: the gate is stricter here than
# in CI, deliberately.
#
# References:
# - https://www.shellcheck.net/wiki/Directive
# - https://www.shellcheck.net/wiki/Optional
# - https://man.archlinux.org/man/extra/shellcheck/shellcheck.1.en

# ============================================================================
# DISABLED CHECKS
# ============================================================================

# SC1090: Can't follow non-constant source
# SC1091: Not following sourced file
# Rationale: wrappers source the library through a configurable path, e.g.
#            LIBRARY_PATH="${HOME}/.local/lib/bash-markdown-link-validator/..."
#            shellcheck cannot resolve these at static analysis time.
disable=SC1090,SC1091

# ============================================================================
# OPTIONAL CHECKS
# ============================================================================

# NOT using enable=all: it activates subjective and partly conflicting optional
# checks meant for discovery, not for a release gate. Enable individual checks
# here if a concrete need arises.
#
# List them with: shellcheck --list-optional

# ============================================================================
# CONFIGURATION
# ============================================================================

# The library requires Bash 4.0+ (associative arrays, ${var,,}, mapfile).
shell=bash

# Resolve sourced files relative to the directory of the script being checked.
source-path=SCRIPTDIR

# Let shellcheck open sourced files where the path is resolvable.
external-sources=true

# Report errors and warnings. CI narrows this to errors only.
severity=warning
